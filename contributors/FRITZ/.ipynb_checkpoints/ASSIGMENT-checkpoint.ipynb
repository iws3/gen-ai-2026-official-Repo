   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "y = x**3 + 1\n",
    "plt.plot(x,y)\n",
    "plt.plot(\"x,y\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"Y\")\n",
    "plt.title(\"y = x**3 + 1\")\n",
    "plt.plot(x,y, color=\"navy\",linewidth=4)\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  },
